#include <windows.h>

1 ICON "assets\\mouseside.ico"
2 ICON "assets\\mouseside_paused.ico"

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS 0x40004
 FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "MouseSide"
      VALUE "FileDescription", "MouseSide - mouse side button mapper"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "ProductName", "MouseSide"
      VALUE "ProductVersion", "1.0.0.0"
      VALUE "OriginalFilename", "MouseSide.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 0x4b0
  END
END

1 24 "mouseside.manifest"
